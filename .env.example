# Discord bot (Discord Developer Portal > Applications > your app)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Raid-Helper premium API (server API key via the /apikey command in Discord)
RAIDHELPER_API_KEY=
RAIDHELPER_SERVER_ID=

# Sync — overridable at runtime via /setup poll-interval-minutes
POLL_INTERVAL_MINUTES=20

# Stats periods: week | month | rolling — overridable at runtime via /setup period-mode
PERIOD_MODE=week
# Only used when PERIOD_MODE=rolling — overridable via /setup period-rolling-days
PERIOD_ROLLING_DAYS=30

# Ranking eligibility: minimum tenure (days since last join) to appear in rankings
# — overridable at runtime via /setup eligibility-min-days
ELIGIBILITY_MIN_DAYS=14

# Number of entries shown in /top and /flop — overridable at runtime via /setup top-flop-size
TOP_FLOP_SIZE=10

# SQLite file location (inside the container, mounted volume)
DB_PATH=./data/bot.sqlite

LOG_LEVEL=info
